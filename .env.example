# Model config
# GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# OR for Vertex AI:
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Robot Config
# Serial port for physical SO-101 robot arm (optional, platform default: /dev/ttyACM0 on Linux, /dev/tty.usbmodem5B415332861 on macOS)
# Linux: /dev/ttyACM0 or /dev/ttyUSB0
# macOS: /dev/tty.usbmodem5B415332861
# ROBOT_PORT=/dev/ttyACM0

# Camera config
# Preferred camera for the live video feed (optional). By default the first external (non
# built-in) camera is used. CAMERA_INDEX is the /dev/videoN number on Linux; CAMERA_NAME is a
# case-insensitive substring of the device name shown in the camera dropdown.
# CAMERA_NAME=Arducam
# CAMERA_INDEX=3

# Browser camera stream (/api/stream). Lower these on slow links; the model always receives
# full-quality frames regardless.
# WEB_STREAM_FPS=15
# WEB_JPEG_QUALITY=75

# Grasp Sensing & Verification
# Aperture the servo reports when closed on nothing (from the real-arm checklist; default: unset, anchors to GRIPPER_CLOSE_DEG)
# GRIPPER_EMPTY_APERTURE_DEG=-74.5
# Margin in degrees above the empty aperture to classify as closed_on_air (default: 6.0)
# GRASP_EMPTY_MARGIN_DEG=6.0
# Stabilization delay in seconds before querying physical servo registers (default: 0.6)
# GRIPPER_SETTLE_S=0.6
# Minimum motor load threshold to confirm physical grasp (optional, default: unset)
# GRASP_LOAD_MIN=20.0

# Closed-Loop Grasping & Guardrails
# Descent gate enforcement mode: block (reject unaligned descent), warn (log warning), off (disable)
# Defaults to block in simulation and warn on physical arm.
# DESCENT_GATE=warn
# Workspace table offsets in robot base frame (mm) on real arm (sim is always 0.0).
# TABLE_X_MM: Forward offset between robot base origin and table mat origin (mm).
# TABLE_Y_MM: Lateral offset between robot base origin and table mat origin (mm).
# TABLE_X_MM=0.0
# TABLE_Y_MM=-60.0
# Set TABLE_Y_MM=-60.0 to match the 60mm base asymmetry on workspace_calibration_sheet.png.
# Robot-frame z of table surface in mm on real arm (sim is always 0.0).
# Measure: hover at 3 cm, ruler to fingertips, TABLE_Z_MM = FK z - measured height.
# TABLE_Z_MM=-24.0
# Jaw ArUco tag centre minus grasp site, gripper frame, mm: x,y,z (README "Jaw tag"; default: -35.4,11.0,40.1)
# GRIPPER_TAG_LOCAL_OFFSET_MM=-35.4,11.0,40.1
# Nominal horizontal field of view of the workspace camera in degrees (default: 70.0)
# CAMERA_HFOV_DEG=70.0
# Jaw-to-target distance in robot mm under which a hover is aligned (default: 4.0)
# ALIGNMENT_TOLERANCE_MM=4.0
# Camera settling delay in seconds before post-action verification frames (default: 0.3)
# VISION_SETTLE_S=0.3

