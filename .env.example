# =============================================================================
# GeminiRobotics-SO101 Environment Configuration
# =============================================================================
# Copy this file to .env and configure your local settings.
# Only GOOGLE_API_KEY (or Vertex credentials) is required to run the Web UI.

# -----------------------------------------------------------------------------
# Required: Gemini Model Credentials
# -----------------------------------------------------------------------------
# Gemini API key from Google AI Studio (default: None)
# GOOGLE_API_KEY=

# Google Cloud project ID for Vertex AI (default: None)
# GOOGLE_CLOUD_PROJECT=

# Google Cloud location for Vertex AI (default: us-central1)
# GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------------------------------------------------------
# Real arm: Physical SO-101 Hardware & Geometry
# -----------------------------------------------------------------------------
# Serial port for physical SO-101 arm (/dev/ttyACM0 on Linux, /dev/tty.usbmodem* on macOS) (default: /dev/ttyACM0)
# ROBOT_PORT=/dev/ttyACM0

# Follower robot identifier for LeRobot calibration (default: follower_droid)
# FOLLOWER_ROBOT_ID=follower_droid

# Explicit path to LeRobot motor calibration JSON (default: None)
# MOTOR_CALIBRATION_PATH=

# Height of table surface in robot base frame in mm on real arm (default: 0.0)
# TABLE_Z_MM=0.0

# Gripper aperture reported when closed on air in degrees (default: None)
# GRIPPER_EMPTY_APERTURE_DEG=

# Margin in degrees above empty aperture to classify as closed_on_air (default: 6.0)
# GRASP_EMPTY_MARGIN_DEG=6.0

# Stabilization delay in seconds before reading gripper registers (default: 0.6)
# GRIPPER_SETTLE_S=0.6

# Minimum motor load threshold to confirm physical grasp (default: None)
# GRASP_LOAD_MIN=

# Jaw ArUco tag center minus grasp site in gripper frame x,y,z in mm (default: -13.4,25.5,78.6)
# GRIPPER_TAG_LOCAL_OFFSET_MM=-13.4,25.5,78.6

# -----------------------------------------------------------------------------
# Camera: Video Capture & Streaming
# -----------------------------------------------------------------------------
# Case-insensitive substring matching device name in camera dropdown (default: None)
# CAMERA_NAME=

# Hardware camera index, e.g. /dev/videoN number on Linux (default: None)
# CAMERA_INDEX=

# Nominal horizontal field of view of workspace camera in degrees (default: 62.2)
# CAMERA_HFOV_DEG=62.2

# Fixed V4L2 camera focus setting when autofocus is disabled (default: 144)
# CAMERA_FOCUS=144

# Frame rate for browser MJPEG video stream at /api/stream (default: 15)
# WEB_STREAM_FPS=15

# JPEG quality 1-100 for browser video stream (default: 75)
# WEB_JPEG_QUALITY=75

# -----------------------------------------------------------------------------
# Advanced: Model, Server & Pipeline Tuning
# -----------------------------------------------------------------------------
# Gemini Live multimodal model identifier (default: gemini-robotics-er-2-streaming-preview)
# GEMINI_MODEL=gemini-robotics-er-2-streaming-preview

# Host address to bind Web UI server (default: 0.0.0.0)
# SERVER_HOST=0.0.0.0

# Port for Web UI server (default: 7860)
# SERVER_PORT=7860

# Path to workspace calibration layout configuration JSON (default: config/workspace_calibration.json)
# CALIBRATION_CONFIG_PATH=config/workspace_calibration.json

# Path to saved real workspace homography matrix file (default: config/workspace_homography.npz)
# CALIBRATION_SAVE_PATH=config/workspace_homography.npz

# Path to saved simulation workspace homography matrix file (default: config/workspace_homography_sim.npz)
# CALIBRATION_SIM_SAVE_PATH=config/workspace_homography_sim.npz

# Jaw-to-target alignment distance threshold in mm for spatial moves (default: 4.0)
# ALIGNMENT_TOLERANCE_MM=4.0

# Internal camera capture frame rate (default: 30)
# STREAM_FPS=30

# Internal camera capture frame width in pixels (default: 640)
# STREAM_WIDTH=640

# Internal camera capture frame height in pixels (default: 480)
# STREAM_HEIGHT=480

# Descent gate policy: 'block', 'warn', or 'off' (default: None)
# DESCENT_GATE=

# Camera feed stabilization delay in seconds before post-action verification (default: 0.3)
# VISION_SETTLE_S=0.3
