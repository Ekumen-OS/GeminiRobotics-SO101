<mujoco model="so101_scene">
    <include file="so101.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="140" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.1 0.15 0.2" rgb2="0.02 0.03 0.05" width="512" height="512" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.15 0.17 0.22" rgb2="0.1 0.12 0.15" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
    </asset>

    <worldbody>
        <!-- Directional light and ground plane -->
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" castshadow="true" />
        <geom name="floor" size="2 2 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Target manipulation object to pick -->
        <body name="target" pos="0.18 0.0 0.015">
            <freejoint name="target_joint"/>
            <geom type="box" size="0.015 0.015 0.015" rgba="0.9 0.2 0.25 1" density="500" contype="1" conaffinity="1"/>
        </body>
    </worldbody>
</mujoco>